# Environment configuration for Drug Response ML project
# Copy to .env and adjust as needed

# Paths (override only if you relocate assets)
MODEL_PATH=models/drug_response_model.pkl
LABEL_PATH=label_mapping.json
SCHEMA_PATH=feature_schema.json
DEMO_CSV_PATH=data/demo_sample.csv

# API / Dashboard
ALLOWED_ORIGINS=*
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_SERVER_PORT=8501
